    "ALTER TABLE ... RENAME TO is not supported for Glue tables",
    "ALTER TABLE ... RENAME COLUMN is not supported for Glue tables",
    "ALTER TABLE ... ALTER COLUMN ... SET DEFAULT is not supported for Glue tables",
    "ALTER TABLE ... ALTER COLUMN ... SET NOT NULL is not supported for Glue tables",
    "ALTER TABLE ... ALTER COLUMN ... DROP NOT NULL is not supported for Glue tables",
    "ALTER TABLE ... ADD CONSTRAINT is not supported for Glue tables",
    "ALTER TABLE ... ADD FOREIGN KEY is not supported for Glue tables",
    "ALTER TABLE ... SET SORTED BY is not supported for Glue tables",
    "ALTER TABLE ... ADD COLUMN on a struct field is not supported for Glue tables",
    "ALTER TABLE ... DROP COLUMN on a struct field is not supported for Glue tables",
    "ALTER TABLE ... RENAME COLUMN on a struct field is not supported for Glue tables",
    "Renaming a view is not supported for Glue views",
    "COMMENT ON TABLE is not supported for Glue tables",
    "COMMENT ON COLUMN is not supported for Glue tables",
    "has no DuckDB definition"
