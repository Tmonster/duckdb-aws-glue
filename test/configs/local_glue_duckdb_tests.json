{
  "description": "Run the duckdb/duckdb sqllogictests against local Glue (moto) and S3 (SeaweedFS), each test in its own Glue database",
  "on_init": "CREATE SECRET (TYPE S3, KEY_ID 'minio', SECRET 'minio123', REGION 'us-east-1', ENDPOINT 'localhost:9100', USE_SSL false, URL_STYLE 'path'); ATTACH '123456789012' AS my_datalake (TYPE GLUE, ENDPOINT 'http://localhost:5555', DEFAULT_LOCATION 's3://glue-test/duckdb_tests/{UUID}', VERIFY_CONNECTION false); CREATE SCHEMA IF NOT EXISTS my_datalake.\"{BASE_TEST_NAME}\";",
  "on_new_connection": "USE my_datalake.\"{BASE_TEST_NAME}\";",
  "init_sqllogic": "../test/configs/local_glue_duckdb_tests_init.sqllogic",
  "cleanup_sqllogic": "../test/configs/local_glue_duckdb_tests_cleanup.sqllogic",
  "statically_loaded_extensions": [
    "core_functions",
    "parquet",
    "json",
    "avro",
    "httpfs",
    "glue"
  ],
  "test_env": [
    {
      "env_name": "GLUE_TEST_CONFIG",
      "env_value": "local_duckdb_tests"
    }
  ],
  "skip_error_messages": [
    "Constraints are not supported when creating tables in a Glue catalog",
    "can not be converted to a Glue type",
    "Transaction support is not provided for Glue catalogs",
    "Glue databases do not support creating",
    "CREATE OR REPLACE TABLE is not supported for Glue catalogs",
    "Glue tables do not support column default values",
    "existing parquet files keep their types",
    "RETURNING clause not yet supported for insertion into a Hive table",
    "Referenced column \"rowid\" not found in FROM clause",
    "does not have a column named \"rowid\"",
    "only supported for DuckDB database files",
    "EXPLAIN (SQL) cannot render table function",
    "Could not retrieve required statistics",
    "Changing Secret Manager settings after the secret manager is used is not allowed",
    "Temporary secret with name \"__default_s3\" already exists",
    "already exists in Glue catalog \"my_datalake\"",
    "because it still contains tables",
    "Referenced column \"ROWID\" not found in FROM clause",
    "Cannot ANALYZE a Hive table",
    "Cannot VACUUM a Hive table",
    "needs at least one column that is not a partition column",
    "requires a transform, but is not a root column",
    "Cannot UPDATE a Hive table",
    "Cannot DELETE from a Hive table",
    "Cannot MERGE INTO a Hive table",
    "Cannot CREATE INDEX on a Hive table",
    "CREATE TRIGGER is not supported for tables in a Glue catalog",
